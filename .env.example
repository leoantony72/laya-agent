# WinBrow configuration — copy to .env and fill in your key
# The brain runs in the cloud; nothing heavy loads locally.

# Nebius Token Factory API key (https://tokenfactory.nebius.com/)
# OpenAI-compatible endpoint: https://api.tokenfactory.nebius.com/v1/
NEBIUS_API_KEY=
# Optional Nebius model/base overrides.
# WINBROW_NEBIUS_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# WINBROW_NEBIUS_BASE=https://api.tokenfactory.nebius.com/v1

# OpenRouter API key (https://openrouter.ai/keys) — optional fallback
OPENROUTER_API_KEY=

# Brain model (default: DeepSeek V4.1 Flash on OpenRouter)
# WINBROW_BRAIN_MODEL=deepseek/deepseek-v4.1-flash

# Upstream OpenRouter provider used for DeepSeek V4.1 Flash (default: relace).
# Leave empty to let OpenRouter pick; set allow_fallbacks=1 to permit fallback.
# WINBROW_OPENROUTER_PROVIDER=relace
# WINBROW_OPENROUTER_ALLOW_FALLBACKS=0

# Which provider is the brain: auto (Nebius → OpenRouter → OpenAI → local)
# | nebius | openrouter | openai | local/qwen.
# Set WINBROW_BRAIN_PROVIDER=nebius to force Token Factory.
# WINBROW_BRAIN_PROVIDER=auto

# Local Qwen brain: uses the bundled GGUF (models/qwen) via llama.cpp on
# 127.0.0.1:8080 — the server auto-downloads llama-server.exe on first run.
# WINBROW_BRAIN_PROVIDER=qwen

# Or point at your own OpenAI-compatible server (Ollama / LM Studio / llama.cpp).
# Set the exact model name to load (required for external servers):
# WINBROW_LOCAL_LLM_ENDPOINT=http://localhost:11434
# WINBROW_LOCAL_LLM_MODEL=qwen2.5:0.5b
# Legacy alias for the built-in local Qwen brain:
# WINBROW_LOCAL_LLM=1

# Brain tuning (local CPU generation gets a higher default: 300s)
# WINBROW_BRAIN_TIMEOUT=45

# Reasoning models (DeepSeek V4.1 Flash) spend max_tokens on hidden thinking
# before writing content. This caps it for JSON/planner calls; chat and STT
# normalization run with reasoning disabled. Some models ignore this, so the
# planner also reserves a large total budget. 0 = let the model decide.
# WINBROW_REASONING_MAX_TOKENS=2000
# Empty planner content (finish_reason=length) retries with these caps:
# WINBROW_REASONING_RETRY_TOKENS=400
# WINBROW_REASONING_OFF_MAX_TOKENS=1000
# Planner total budget and temperature (reasoning models need temperature=1).
# WINBROW_PLANNER_MAX_TOKENS=16000
# WINBROW_PLANNER_TEMPERATURE=1

# Action budget for one brain task. Multi-step flows (find a file, upload it,
# verify the result) usually need 15-20; 30 leaves room for recovery.
# WINBROW_MAX_STEPS=30
# Inject a "N steps remaining" warning this many actions before the hard stop.
# WINBROW_STEP_WARN=5
# Raise on slow CPUs so multi-thousand-token planner prompts can finish:
# WINBROW_LOCAL_LLM_TIMEOUT=600
# Context size / threads for the built-in llama.cpp server (defaults: 8192 / core count)
# WINBROW_LOCAL_LLM_CTX=8192
# WINBROW_LOCAL_LLM_THREADS=2

# Auto-approval and permission confirmation bypass:
# Auto-approve Tier 2 actions (file writes, running commands, closing windows)
# WINBROW_AUTO_APPROVE_T2=1
# Or completely bypass confirmation for all actions (including T3 system/install actions)
# WINBROW_BYPASS_CONFIRM=1

# Every request attempts the brain first. Set 0 only for legacy fast-path debugging.
# WINBROW_BRAIN_FIRST=1

# Scoped subagents: 0 disables, EXPLICIT=1 requires the user to ask.
# WINBROW_SUBAGENTS=1
# WINBROW_SUBAGENTS_EXPLICIT=0
# WINBROW_SUBAGENT_PARALLEL=3

# Web search (DuckDuckGo) transport. Plain requests gets an HTTP 202 bot
# challenge, so search uses curl_cffi browser fingerprints. Comma-separated
# order; a challenged identity is retried once before the next is tried.
# WINBROW_TLS_IMPERSONATE=chrome124,safari17_0
# Total budget for one web_search call, shared by both DDG endpoints (5-40s).
# WINBROW_SEARCH_TIMEOUT=20
# When web_fetch gets a focus question, keep only the most relevant sections
# up to this many characters (1500-40000).
# WINBROW_FETCH_FOCUS_CHARS=6000

# Wallpapers. set_wallpaper searches Wallhaven's keyless SFW API and downloads
# the image itself — no browser, no API key. Defaults below are optional.
# Subject used when the user asks for "a wallpaper" with no topic.
# WINBROW_WALLPAPER_QUERY=anime
# Minimum acceptable resolution (width x height) for a downloaded wallpaper.
# WINBROW_WALLPAPER_MIN=1600x900
# Where downloads are stored (default: %USERPROFILE%\Pictures\WinBrow Wallpapers).
# WINBROW_WALLPAPER_DIR=
# Keep the user's existing wallpaper fit mode instead of forcing "Fill".
# WINBROW_WALLPAPER_KEEP_STYLE=1

# General image download (download_images tool). Saves to
# %USERPROFILE%\Pictures\WinBrow Images unless the user names a folder.
# Root folder for every image download (overrides the Pictures/Downloads/... aliases):
# WINBROW_IMAGE_DIR=
# Browser user agent used for image APIs/CDNs.
# WINBROW_IMAGE_UA=
