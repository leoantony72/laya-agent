# WinBrow configuration — copy to .env and fill in your key
# The brain runs in the cloud; nothing heavy loads locally.

# OpenRouter API key (https://openrouter.ai/keys) — REQUIRED for the brain
OPENROUTER_API_KEY=

# Brain model (default: DeepSeek V4.1 Flash on OpenRouter)
# WINBROW_BRAIN_MODEL=deepseek/deepseek-v4.1-flash

# Optional: offline fallback via local OpenAI-compatible server
# WINBROW_LOCAL_LLM_ENDPOINT=http://localhost:11434
# WINBROW_LOCAL_LLM_MODEL=

# Optional: force the old local Qwen brain (not recommended: needs hardware)
# WINBROW_LOCAL_LLM=1

# Brain tuning
# WINBROW_BRAIN_TIMEOUT=45
